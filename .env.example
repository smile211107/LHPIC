# Chuỗi kết nối PostgreSQL (Neon, Supabase, Vercel Postgres...)
# Khi tích hợp Neon/Supabase qua Vercel Marketplace, biến này thường được tự động thêm vào.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Tài khoản quản trị Admin CMS (bắt buộc đổi khi lên production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lhpic_change_this_password

# Chuỗi bí mật để ký cookie phiên đăng nhập (nên đặt chuỗi ngẫu nhiên dài >= 32 ký tự)
AUTH_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
